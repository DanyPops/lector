{
	"$schema": "https://biomejs.dev/schemas/2.5.6/schema.json",
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noExplicitAny": "off",
				"noImportCycles": "error"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"formatWithErrors": false,
		"indentStyle": "tab",
		"lineWidth": 160
	},
	"files": {
		"includes": ["packages/*/src/**/*.ts", "packages/*/extension/src/**/*.ts", "packages/*/test/**/*.ts", "!packages/*/test/fixtures", "!**/node_modules"]
	}
}
