{
  "name": "@danypops/zodiac-lector",
  "version": "0.0.9",
  "description": "Package-owned Lector contribution for Zodiac workspace resources",
  "keywords": ["zodiac", "lector", "code-intelligence"],
  "license": "MIT",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": { ".": "./src/index.ts", "./zodiac-entry": "./dist/zodiac-entry.js" },
  "files": ["src", "dist", "vendor", "README.md", "LICENSE"],
  "zodiac": { "integrations": [{ "kind": "editor", "entry": "./dist/zodiac-entry.js" }] },
  "scripts": { "build": "bun build src/zodiac-entry.ts --target=node --outfile=dist/zodiac-entry.js", "prepack": "bun run build", "test": "bun test", "typecheck": "tsc --noEmit" },
  "dependencies": {
    "@zodiac/protocol": "file:vendor/zodiac-protocol-0.0.1.tgz",
    "@danypops/lector": "^0.19.0"
  },
  "devDependencies": { "bun-types": "latest", "typescript": "^5.9.3" },
  "repository": { "type": "git", "url": "git+https://github.com/DanyPops/lector.git", "directory": "packages/zodiac-lector" },
  "publishConfig": { "access": "public" }
}
