		"@earendil-works/pi-coding-agent": "^0.81.1",
		"@earendil-works/pi-tui": "^0.81.1",
		"@types/picomatch": "^4.0.3",
		"bun-types": "latest",
		"typebox": "^1.3.6",
		"typescript": "^5.7.3"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DanyPops/lector.git",
