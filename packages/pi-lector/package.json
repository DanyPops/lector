{
	"name": "@danypops/pi-lector",
	"version": "0.13.7",
	"description": "Pi host adapter for Lector: overrides read/write/edit with a daemon-backed, hash-guarded filesystem",
	"license": "MIT",
	"type": "module",
	"keywords": ["pi-package"],
	"scripts": {
