{
	"name": "@danypops/lector",
	"version": "0.19.1",
	"description": "Platform-neutral filesystem & code-intelligence capability: core, service, and driven adapters",
	"license": "MIT",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./src/index.ts",
	"exports": {
		".": "./src/index.ts",
		"./client": "./src/client.ts",
		"./service": "./src/service.ts",
		"./code-intelligence": "./src/code-intelligence/index.ts",
		"./concurrency": "./src/concurrency/index.ts",
		"./content-cache": "./src/content-cache/index.ts",
		"./content-identity": "./src/content-identity/index.ts",
		"./external-search": "./src/external-search/index.ts",
		"./external-search-cache": "./src/external-search-cache/index.ts",
		"./file-watcher": "./src/file-watcher/index.ts",
		"./git": "./src/git/index.ts",
		"./github-search": "./src/github-search/index.ts",
		"./installed-package-version-resolver": "./src/installed-package-version-resolver/index.ts",
		"./live-buffer": "./src/live-buffer/index.ts",
		"./live-buffer/guarded": "./src/live-buffer/guarded-live-buffer.ts",
		"./lsp-provisioning": "./src/lsp-provisioning/index.ts",
		"./mutation-history": "./src/mutation-history/index.ts",
		"./npm-registry": "./src/npm-registry/index.ts",
		"./package-source": "./src/package-source/index.ts",
		"./path-safety": "./src/path-safety/index.ts",
		"./reference-based-rename": "./src/reference-based-rename/index.ts",
		"./repo-fetcher": "./src/repo-fetcher/index.ts",
		"./search-cache": "./src/search-cache/index.ts",
		"./sourcegraph-search": "./src/sourcegraph-search/index.ts",
		"./symbol-annotation": "./src/symbol-annotation/index.ts",
		"./symbol-graph": "./src/symbol-graph/index.ts",
		"./text-search": "./src/text-search/index.ts",
		"./workspace": "./src/workspace/index.ts",
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"bin": {
		"lector": "src/cli.ts"
	},
	"scripts": {
		"test": "bun test",
		"test:fast": "bun test --parallel=4",
		"test:timing": "bun dev-tools/test-timing/run.ts",
		"typecheck": "tsc --noEmit",
		"cli": "bun src/cli.ts",
		"serve": "bun src/cli.ts serve",
		"bench:cold-start": "bun benchmarks/language-server-cold-start.ts"
	},
	"packed": {
		"daemonService": {
			"name": "lector",
			"displayName": "Lector filesystem & code-intelligence service",
			"binPath": "src/cli.ts",
			"args": ["serve"],
			"handleFilename": "handle.json",
			"restartOnFailure": true,
			"restartSec": 2
		}
	},
	"dependencies": {
		"@codemirror/state": "^6.7.1",
		"@danypops/vehicle-client": "^0.10.0",
		"@danypops/vehicle-core": "^0.12.5",
		"@danypops/vehicle-server": "^0.24.1",
		"@yarnpkg/parsers": "^3.0.3",
		"diff": "^9.0.0",
		"eventsource-parser": "^3.1.0",
		"fetch-retry": "^6.0.0",
		"graphology": "^0.26.0",
		"graphology-metrics": "^2.4.0",
		"ignore": "^7.0.6",
		"jsonc-parser": "^3.3.1",
		"lru-cache": "^11.5.2",
		"picomatch": "^4.0.5",
		"pyright": "^1.1.411",
		"simple-git": "^3.36.0",
		"tree-sitter-wasms": "^0.1.13",
		"typescript": "^5.9.3",
		"typescript-language-server": "^5.3.0",
		"web-tree-sitter": "0.20.8",
		"yaml": "^2.9.0",
		"yaml-language-server": "^1.24.0"
	},
	"devDependencies": {
		"@types/picomatch": "^4.0.3",
		"bun-types": "latest"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/DanyPops/lector.git",
		"directory": "packages/lector"
	},
	"homepage": "https://github.com/DanyPops/lector#readme",
	"bugs": {
		"url": "https://github.com/DanyPops/lector/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"files": ["src", "README.md", "LICENSE"]
}
